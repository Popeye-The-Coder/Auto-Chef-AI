# AutoChef Environment Configuration
PROJECT_NAME="AutoChef"
API_V1_STR="/api/v1"
SECRET_KEY="autochef-super-secure-ml-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database
DATABASE_URL="sqlite:///./autochef.db"

# Storage
UPLOAD_DIR="./uploads"
TRAINED_MODELS_DIR="./trained_models"
DATASETS_DIR="./datasets"

# ML Configurations
YOLO_MODEL_PATH="./trained_models/ingredient_yolo.pt"
CONFIDENCE_THRESHOLD=0.35
ENABLE_CUDA=true
DEVICE="cuda"
